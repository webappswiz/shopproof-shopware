{% sw_extends '@Storefront/storefront/component/line-item/type/generic.html.twig' %}

{# The deposit line is money, not goods: no placeholder picture and no delivery period, as
   shops show a deposit line on their own. The empty picture column keeps the columns aligned. #}
{% block component_line_item_type_generic_image_inner %}
    {% if lineItem.type != 'shopproof-deposit' %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block component_line_item_type_generic_delivery_date %}
    {% if lineItem.type != 'shopproof-deposit' %}
        {{ parent() }}
    {% endif %}
{% endblock %}
