{% sw_extends '@Storefront/storefront/component/buy-widget/buy-widget.html.twig' %}

{# Shop notes next to the price. Right below the price: the bottle deposit ("plus EUR 0.25
   deposit"), only for shoppers whose shipping country has the deposit type. Shopware's own tax
   line ("Prices incl. VAT plus shipping costs", linked to the shipping page) stays, with other
   words only for the small business scheme, free shipping or a margin scheme product. Below it,
   the known defects of used goods. Nothing changes with the default settings. #}
{% block buy_widget_price %}
    {{ parent() }}
    {# The energy label arrow and the French index, right next to the price (EU-EL-01, FR-EN-01). #}
    {% block shopproof_buy_widget_energy %}
        {% sw_include '@ShopproofCompliance/storefront/shopproof/energy.html.twig' with { product: product } %}
    {% endblock %}
    {# The lowest price of the 30 days before a reduction (decision 0040), right below a reduced price. #}
    {% block shopproof_buy_widget_prior_price %}
        {% set shopproofPriorPrice = shopproof_prior_price(product, context) %}
        {% if shopproofPriorPrice %}
            <p class="shopproof-prior-price small mb-1">{{ shopproofPriorPrice }}</p>
        {% endif %}
    {% endblock %}
    {% block shopproof_buy_widget_deposit %}
        {% set shopproofDeposit = shopproof_deposit_note(product, context) %}
        {% if shopproofDeposit %}
            <p class="shopproof-deposit small mb-1">{{ shopproofDeposit }}</p>
        {% endif %}
    {% endblock %}
{% endblock %}

{% block buy_widget_tax_link %}
    {% set shopproofTaxLine = shopproof_price_tax_line(product, context) %}
    {% if shopproofTaxLine %}
        {% set cmsPath = path('frontend.cms.page', { id: config('core.basicInformation.shippingPaymentInfoPage') }) %}
        <button class="btn btn-link-inline product-detail-tax-link"
                type="button"
                data-ajax-modal="true"
                data-url="{{ cmsPath }}"
                aria-haspopup="dialog">
            {{ shopproofTaxLine }}
        </button>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block buy_widget_tax %}
    {{ parent() }}
    {% block shopproof_buy_widget_defects %}
        {% set shopproofDefects = shopproof_defects(product, context) %}
        {% if shopproofDefects %}
            <p class="shopproof-defects small"><strong>{{ shopproofDefects.label }}</strong> {{ shopproofDefects.text|nl2br }}</p>
        {% endif %}
    {% endblock %}
{% endblock %}
