{% block shopproof_overview_index %}
<sw-page class="shopproof-overview">
    <template #smart-bar-header>
        <h2>
            <span>{{ $t('sw-settings.index.title') }}</span>
            <mt-icon name="regular-chevron-right-xs" size="12px" />
            <span>{{ $t('shopproof.general.title') }}</span>
        </h2>
    </template>

    <template #content>
        <sw-card-view>
            <div v-if="check && check.failedRecords > 0" class="shopproof-overview__alert" role="alert">
                <p>
                    <strong>{{ $tc('shopproof.withdrawal.failedRecords', check.failedRecords, { count: check.failedRecords }) }}</strong>
                </p>
                <p>{{ $t('shopproof.withdrawal.failedHelp') }}</p>
                <mt-button size="small" variant="secondary" :disabled="clearing" @click="clearFailures">
                    {{ $t('shopproof.withdrawal.failedClear') }}
                </mt-button>
            </div>

            <shopproof-setup-overview ref="setup" :rules="overview && overview.rules ? overview.rules : []" />

            <mt-card
                position-identifier="shopproof-overview-about"
                :title="$t('shopproof.overview.aboutTitle')"
                :is-loading="isLoading"
            >
                <p class="shopproof-overview__disclaimer">
                    <strong>{{ overview && overview.disclaimer ? overview.disclaimer : $t('shopproof.overview.disclaimer') }}</strong>
                </p>
                <p v-if="failed" role="alert">{{ $t('shopproof.overview.loadFailed') }}</p>
                <p v-else-if="overview && !overview.available">{{ $t('shopproof.overview.notYet') }}</p>
                <p v-else-if="overview && overview.downloaded">
                    {{ $t('shopproof.overview.version', { version: overview.version, date: fetchedAt }) }}
                </p>
                <p v-else-if="overview">
                    {{ $t('shopproof.overview.versionBundled', { version: overview.version }) }}
                </p>
                <p>{{ $t('shopproof.overview.countriesHint') }}</p>
                <p v-if="overview">{{ overview.autoUpdate ? $t('shopproof.overview.autoOn') : $t('shopproof.overview.autoOff') }}</p>
                <mt-button variant="secondary" :is-loading="refreshing" :disabled="refreshing" @click="refreshRules">
                    {{ $t('shopproof.overview.refresh') }}
                </mt-button>
                <p v-if="refreshResult" role="status">{{ $t(`shopproof.overview.refresh_${refreshResult}`) }}</p>
            </mt-card>

            <mt-card
                position-identifier="shopproof-overview-withdrawal-check"
                :title="$t('shopproof.withdrawal.checkTitle')"
                :is-loading="!check && !checkFailed"
            >
                <p v-if="checkFailed" role="alert">{{ $t('shopproof.withdrawal.checkFailed') }}</p>
                <p v-else-if="check && !check.supported">{{ $t('shopproof.withdrawal.unsupported') }}</p>
                <template v-else-if="check">
                    <p :class="check.ok ? 'shopproof-overview__ok' : 'shopproof-overview__todo'">
                        <strong>{{ check.ok ? $t('shopproof.withdrawal.allGood') : $t('shopproof.withdrawal.needsWork') }}</strong>
                    </p>
                    <ul class="shopproof-overview__checks">
                        <li v-for="item in check.shop" :key="item.key">
                            <span class="shopproof-overview__state">{{ item.ok ? $t('shopproof.withdrawal.done') : $t('shopproof.withdrawal.todo') }}</span>
                            {{ checkText(item) }}
                        </li>
                    </ul>
                    <section v-for="channel in check.channels" :key="channel.id" :aria-label="channel.name">
                        <h3 class="shopproof-overview__rule-title">{{ channel.name }}</h3>
                        <ul class="shopproof-overview__checks">
                            <li v-for="item in channel.checks" :key="item.key">
                                <span class="shopproof-overview__state">{{ item.ok ? $t('shopproof.withdrawal.done') : $t('shopproof.withdrawal.todo') }}</span>
                                {{ checkText(item) }}
                            </li>
                        </ul>
                    </section>
                    <p>{{ $t('shopproof.withdrawal.where') }}</p>
                </template>
            </mt-card>

            <shopproof-placement v-if="check && check.supported" @checked="onPlacementChecked" />

            <mt-card
                v-if="check && ((check.layouts && check.layouts.length) || (check.products && check.products.length))"
                position-identifier="shopproof-overview-layouts"
                :title="$t('shopproof.layouts.title')"
            >
                <ul v-if="check.products && check.products.length" class="shopproof-overview__checks">
                    <li v-for="item in check.products" :key="item.key">
                        <span class="shopproof-overview__state">{{ item.ok ? $t('shopproof.withdrawal.done') : $t('shopproof.products.warn') }}</span>
                        {{ $t(`shopproof.products.${item.key}_${item.ok ? 'ok' : 'off'}`) }}
                        <ul v-if="item.key === 'manufacturerDetails' && !item.ok" class="shopproof-overview__names">
                            <li v-for="manufacturer in check.manufacturersWithoutDetails" :key="manufacturer.id">
                                <router-link :to="{ name: 'sw.manufacturer.detail', params: { id: manufacturer.id } }">{{ manufacturer.name || manufacturer.id }}</router-link>
                            </li>
                        </ul>
                        <ul v-if="item.key === 'hazardStatements' && check.hazardProblems" class="shopproof-overview__names">
                            <li v-for="product in check.hazardProblems" :key="product.id">
                                <router-link :to="{ name: 'sw.product.detail', params: { id: product.id } }">{{ product.name || product.id }}</router-link>:
                                {{ product.codes.map((line) => `${line.code} (${$t(line.reason === 'own' ? 'shopproof.products.hazardOwn' : 'shopproof.products.hazardUnknown')})`).join(', ') }}
                            </li>
                        </ul>
                        <ul v-if="item.key === 'registrationNumbers' && check.registrationBadLines" class="shopproof-overview__names">
                            <li v-for="line in check.registrationBadLines" :key="line">{{ line }}</li>
                        </ul>
                    </li>
                </ul>
                <div v-if="shopDetails && shopDetails.fills && shopDetails.fills.length" class="shopproof-overview__own-goods">
                    <p><strong>{{ $t('shopproof.products.ownGoodsTitle') }}</strong></p>
                    <p>{{ $t('shopproof.products.ownGoodsText') }}</p>
                    <p class="shopproof-overview__comment">{{ [shopDetails.shop.name, shopDetails.shop.address, shopDetails.shop.email, shopDetails.shop.url].filter(Boolean).join('\n') }}</p>
                    <mt-button variant="secondary" :is-loading="usingShopDetails" @click="useShopDetails">{{ $t('shopproof.products.ownGoodsButton') }}</mt-button>
                </div>
                <p v-if="shopDetailsResult" role="status">{{ $t(`shopproof.products.ownGoods_${shopDetailsResult}`) }}</p>
                <p v-if="check.layouts && check.layouts.length">{{ $t('shopproof.layouts.intro') }}</p>
                <ul v-if="check.layouts && check.layouts.length" class="shopproof-overview__checks">
                    <li v-for="layout in check.layouts" :key="layout.id">
                        <span class="shopproof-overview__state">{{ layout.ok ? $t('shopproof.withdrawal.done') : $t('shopproof.withdrawal.todo') }}</span>
                        <router-link :to="{ name: 'sw.cms.detail', params: { id: layout.id } }">{{ layout.name }}</router-link>:
                        {{ layout.ok ? $t('shopproof.layouts.ok') : $t('shopproof.layouts.missing', { blocks: layout.missing.map((part) => $t(`shopproof.layouts.part.${part}`)).join(', ') }) }}
                    </li>
                </ul>
            </mt-card>

            <mt-card
                v-if="check && check.notes && check.notes.length"
                position-identifier="shopproof-overview-notes"
                :title="$t('shopproof.notes.title')"
            >
                <ul class="shopproof-overview__checks">
                    <li v-for="item in check.notes" :key="`${item.key}-${item.channel || ''}`">
                        <span class="shopproof-overview__state">{{ item.ok ? $t('shopproof.withdrawal.done') : $t('shopproof.products.warn') }}</span>
                        <strong v-if="item.channel">{{ $t('shopproof.notes.policyChannel', { channel: item.channel }) }}</strong>
                        {{ $t(`shopproof.notes.${item.key}_${item.ok ? 'ok' : 'off'}`, { detail: item.detail || '' }) }}
                        <ul v-if="item.key === 'unitPrices' && check.unitPriceGaps" class="shopproof-overview__names">
                            <li v-for="product in check.unitPriceGaps" :key="product.id">
                                <router-link :to="{ name: 'sw.product.detail', params: { id: product.id } }">{{ product.name || product.id }}</router-link>
                            </li>
                        </ul>
                        <ul v-if="item.key === 'depositTypes' && check.depositBadLines" class="shopproof-overview__names">
                            <li v-for="line in check.depositBadLines" :key="line">{{ line }}</li>
                        </ul>
                        <ul v-if="item.key === 'checkoutPolicyPages' && item.detail" class="shopproof-overview__names">
                            <li v-for="box in item.detail.split(', ')" :key="box">{{ $t(`shopproof.notes.box_${box}`) }}</li>
                        </ul>
                    </li>
                </ul>
                <template v-if="check.disputeStatements && check.disputeStatements.length">
                    <p>{{ $t('shopproof.notes.disputeIntro') }}</p>
                    <blockquote v-for="(statement, index) in check.disputeStatements" :key="index" class="shopproof-overview__statement">{{ statement }}</blockquote>
                </template>
                <p>{{ $t('shopproof.notes.where') }}</p>
            </mt-card>

            <shopproof-green-claims />

            <shopproof-a11y-statement />

            <mt-card
                position-identifier="shopproof-overview-bulk"
                :title="$t('shopproof.bulk.title')"
            >
                <p>{{ $t('shopproof.bulk.intro') }}</p>
                <ol class="shopproof-overview__steps">
                    <li>{{ $t('shopproof.bulk.step1') }}</li>
                    <li>{{ $t('shopproof.bulk.step2') }}</li>
                    <li>{{ $t('shopproof.bulk.step3') }}</li>
                </ol>
                <p>{{ $t('shopproof.bulk.manufacturers') }}</p>
                <p>{{ $t('shopproof.bulk.bulkEdit') }}</p>
                <div class="shopproof-overview__actions">
                    <router-link :to="{ name: 'sw.import.export.index.export' }">{{ $t('shopproof.bulk.openImport') }}</router-link>
                    <router-link :to="{ name: 'sw.product.index' }">{{ $t('shopproof.bulk.openProducts') }}</router-link>
                </div>
            </mt-card>

            <mt-card
                id="shopproof-proof-log"
                position-identifier="shopproof-overview-proof-log"
                :title="$t('shopproof.proof.title')"
                :is-loading="proofLoading"
            >
                <p>{{ $t('shopproof.proof.intro') }}</p>
                <p v-if="proofFailed" role="alert">{{ $t('shopproof.proof.loadFailed') }}</p>
                <p v-else-if="proof && !proof.available" role="alert">{{ $t('shopproof.proof.unavailable') }}</p>
                <template v-else-if="proof">
                    <p v-if="proof.lastSnapshot">{{ $t('shopproof.proof.lastSnapshot', { date: proof.lastSnapshot }) }}</p>
                    <p>{{ proof.retentionDays > 0 ? $t('shopproof.proof.retention', { days: proof.retentionDays }) : $t('shopproof.proof.retentionAll') }}</p>
                    <div class="shopproof-overview__actions">
                        <mt-button variant="secondary" :is-loading="verifying" :disabled="verifying" @click="verifyProof">{{ $t('shopproof.proof.verify') }}</mt-button>
                        <mt-button variant="secondary" :is-loading="snapshotting" :disabled="snapshotting" @click="recordSnapshot">{{ $t('shopproof.proof.snapshot') }}</mt-button>
                        <mt-button variant="secondary" :disabled="proof.total === 0" @click="downloadProof">{{ $t('shopproof.proof.download') }}</mt-button>
                    </div>
                    <p v-if="verifyResult" role="status" :class="verifyResult.ok ? 'shopproof-overview__ok' : 'shopproof-overview__todo'">
                        {{ verifyResult.failed ? $t('shopproof.proof.verifyFailed') : (verifyResult.ok ? $t('shopproof.proof.verifyOk', { count: verifyResult.checked }) : $t('shopproof.proof.verifyBroken', { id: verifyResult.brokenAt, count: verifyResult.checked })) }}
                    </p>
                    <p v-if="proof.total === 0">{{ $t('shopproof.proof.none') }}</p>
                    <template v-else>
                        <table class="shopproof-overview__table">
                            <caption class="shopproof-overview__sr">{{ $t('shopproof.proof.title') }}</caption>
                            <thead>
                                <tr>
                                    <th scope="col">{{ $t('shopproof.proof.time') }}</th>
                                    <th scope="col">{{ $t('shopproof.proof.type') }}</th>
                                    <th scope="col">{{ $t('shopproof.proof.summary') }}</th>
                                    <th scope="col">{{ $t('shopproof.proof.hash') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="entry in proof.items" :key="entry.id">
                                    <td>{{ entry.created_at }}</td>
                                    <td>{{ $t(`shopproof.proof.types.${entry.type}`) }}</td>
                                    <td class="shopproof-overview__comment"><code>{{ entry.summary }}</code></td>
                                    <td><code :title="entry.hash">{{ entry.hash.slice(0, 12) }}</code></td>
                                </tr>
                            </tbody>
                        </table>
                        <sw-pagination
                            v-if="proof.total > 25"
                            :page="proofPage"
                            :limit="25"
                            :total="proof.total"
                            :steps="[25]"
                            @page-change="onProofPageChange"
                        />
                    </template>
                </template>
            </mt-card>

            <mt-card
                id="shopproof-withdrawals"
                position-identifier="shopproof-overview-withdrawals"
                :title="$t('shopproof.withdrawal.listTitle')"
                :is-loading="withdrawalsLoading"
            >
                <p>{{ $t('shopproof.withdrawal.listIntro') }}</p>
                <p><small>{{ $t('shopproof.withdrawal.clock.help') }}</small></p>
                <form class="shopproof-overview__search" role="search" @submit.prevent="search">
                    <label for="shopproof-withdrawal-search">{{ $t('shopproof.withdrawal.searchLabel') }}</label>
                    <input id="shopproof-withdrawal-search" v-model="term" type="search" class="shopproof-overview__search-input">
                    <mt-button variant="secondary" type="submit">{{ $t('shopproof.withdrawal.search') }}</mt-button>
                    <mt-button
                        variant="secondary"
                        :disabled="!withdrawals || withdrawals.total === 0"
                        :is-loading="exporting"
                        @click="exportWithdrawals"
                    >{{ $t('shopproof.withdrawal.export') }}</mt-button>
                </form>
                <p v-if="exportFailed" role="alert">{{ $t('shopproof.withdrawal.exportFailed') }}</p>
                <p v-if="withdrawalsFailed" role="alert">{{ $t('shopproof.withdrawal.listFailed') }}</p>
                <p v-else-if="withdrawals && withdrawals.total === 0">{{ $t('shopproof.withdrawal.none') }}</p>
                <template v-else-if="withdrawals">
                    <table class="shopproof-overview__table">
                        <caption class="shopproof-overview__sr">{{ $t('shopproof.withdrawal.listTitle') }}</caption>
                        <thead>
                            <tr>
                                <th scope="col">{{ $t('shopproof.withdrawal.received') }}</th>
                                <th scope="col">{{ $t('shopproof.withdrawal.customer') }}</th>
                                <th scope="col">{{ $t('shopproof.withdrawal.contract') }}</th>
                                <th scope="col">{{ $t('shopproof.withdrawal.comment') }}</th>
                                <th scope="col">{{ $t('shopproof.withdrawal.status') }}</th>
                                <th scope="col">{{ $t('shopproof.withdrawal.deadlines') }}</th>
                                <th scope="col"><span class="shopproof-overview__sr">{{ $t('shopproof.withdrawal.actions') }}</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="item in withdrawals.items" :key="item.id">
                                <td>{{ formatTime(item.submittedAt) }}<br><small>{{ item.salesChannel }}</small></td>
                                <td>{{ [item.firstName, item.lastName].filter(Boolean).join(' ') }}<br><a :href="`mailto:${item.email}`">{{ item.email }}</a></td>
                                <td>
                                    <router-link v-if="item.orderId" :to="orderLink(item.orderId)">{{ item.contractNumber }}</router-link>
                                    <template v-else>{{ item.contractNumber }}<br><small>{{ $t('shopproof.withdrawal.noOrder') }}</small></template>
                                    <template v-if="item.orderDate"><br><small>{{ $t('shopproof.withdrawal.orderDate') }}: {{ item.orderDate }}</small></template>
                                    <p v-if="item.business && item.business.length" class="shopproof-overview__tone shopproof-overview__tone--warn"><small><strong>{{ $t('shopproof.withdrawal.businessTitle') }}</strong> {{ $t(`shopproof.withdrawal.business_${item.business.join('_')}`) }} {{ $t('shopproof.withdrawal.businessText') }}</small></p>
                                </td>
                                <td class="shopproof-overview__comment">
                                    <template v-if="item.items"><strong>{{ $t('shopproof.withdrawal.items') }}</strong><br>{{ item.items }}<br></template>
                                    {{ item.comment }}
                                </td>
                                <td>
                                    <label :for="`shopproof-status-${item.id}`" class="shopproof-overview__sr">{{ $t('shopproof.withdrawal.status') }}</label>
                                    <select
                                        :id="`shopproof-status-${item.id}`"
                                        class="shopproof-overview__status"
                                        :value="item.status"
                                        @change="askStatus(item, $event)"
                                    >
                                        <option v-for="state in ['received', 'return_arrived', 'refund_sent']" :key="state" :value="state">{{ $t(`shopproof.withdrawal.states.${state}`) }}</option>
                                    </select>
                                    <div v-if="pendingStatus && pendingStatus.id === item.id" class="shopproof-overview__confirm" role="group" :aria-label="$t('shopproof.withdrawal.confirmStatus')">
                                        <p><small>{{ $t('shopproof.withdrawal.confirmStatus') }}</small></p>
                                        <mt-button size="small" variant="primary" @click="confirmStatus(item)">{{ $t('shopproof.withdrawal.confirmYes') }}</mt-button>
                                        <mt-button size="small" variant="secondary" @click="cancelStatus(item)">{{ $t('shopproof.withdrawal.confirmNo') }}</mt-button>
                                    </div>
                                    <p v-if="statusNotice && statusNotice.show && statusNotice.id === item.id" role="status"><small>{{ $t(`shopproof.withdrawal.${statusNotice.key}`) }}</small></p>
                                    <p v-if="item.webhook" :class="`shopproof-overview__tone shopproof-overview__tone--${webhookTone(item.webhook)}`"><small>{{ webhookText(item.webhook) }}</small></p>
                                </td>
                                <td class="shopproof-overview__clock">
                                    <p v-for="(line, index) in clockLines(item.clock)" :key="index" :class="`shopproof-overview__tone shopproof-overview__tone--${line[1]}`">{{ line[0] }}</p>
                                    <label :for="`shopproof-delivered-${item.id}`"><small>{{ $t('shopproof.withdrawal.deliveredOn') }}</small></label>
                                    <input
                                        :id="`shopproof-delivered-${item.id}`"
                                        type="date"
                                        :value="item.deliveredOn"
                                        :title="$t('shopproof.withdrawal.deliveredHelp')"
                                        @change="setDelivered(item, $event.target.value)"
                                    >
                                    <small v-if="item.clock && item.clock.deliveredSource === 'shipped'"><br>{{ $t('shopproof.withdrawal.estimated') }}</small>
                                    <p v-if="showRefundLink(item)" class="shopproof-overview__refund">
                                        <router-link :to="orderLink(item.orderId)">{{ $t('shopproof.withdrawal.refundOnOrder') }}</router-link>
                                        <br><small>{{ $t('shopproof.withdrawal.refundOnOrderHelp') }}</small>
                                    </p>
                                </td>
                                <td>
                                    <template v-if="confirmId === item.id">
                                        <mt-button size="small" variant="critical" @click="removeWithdrawal(item.id)">{{ $t('shopproof.withdrawal.confirmDelete') }}</mt-button>
                                        <mt-button size="small" variant="secondary" @click="confirmId = null">{{ $t('shopproof.withdrawal.cancel') }}</mt-button>
                                    </template>
                                    <mt-button v-else size="small" variant="secondary" @click="confirmId = item.id">{{ $t('shopproof.withdrawal.delete') }}</mt-button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <sw-pagination
                        v-if="withdrawals.total > 25"
                        :page="page"
                        :limit="25"
                        :total="withdrawals.total"
                        :steps="[25]"
                        @page-change="onPageChange"
                    />
                </template>
            </mt-card>

            <mt-card
                id="shopproof-cancellations"
                position-identifier="shopproof-overview-cancellations"
                :title="$t('shopproof.cancel.title')"
                :is-loading="cancellationsLoading"
            >
                <p>{{ $t('shopproof.cancel.intro') }}</p>
                <p v-if="cancellationsFailed" role="alert">{{ $t('shopproof.cancel.failed') }}</p>
                <p v-else-if="cancellations && cancellations.total === 0">{{ $t('shopproof.cancel.none') }}</p>
                <template v-else-if="cancellations">
                    <p v-if="cancellations.open > 0"><strong>{{ $tc('shopproof.cancel.open', cancellations.open, { count: cancellations.open }) }}</strong></p>
                    <table class="shopproof-overview__table">
                        <caption class="shopproof-overview__sr">{{ $t('shopproof.cancel.title') }}</caption>
                        <thead>
                            <tr>
                                <th scope="col">{{ $t('shopproof.withdrawal.received') }}</th>
                                <th scope="col">{{ $t('shopproof.withdrawal.customer') }}</th>
                                <th scope="col">{{ $t('shopproof.withdrawal.contract') }}</th>
                                <th scope="col">{{ $t('shopproof.cancel.end') }}</th>
                                <th scope="col">{{ $t('shopproof.withdrawal.status') }}</th>
                                <th scope="col"><span class="shopproof-overview__sr">{{ $t('shopproof.withdrawal.actions') }}</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="item in cancellations.items" :key="item.id">
                                <td>{{ formatTime(item.receivedAt) }}<br><small>{{ item.reference }}</small><template v-if="item.salesChannel"><br><small>{{ item.salesChannel }}</small></template></td>
                                <td>{{ item.name }}<br><small>{{ item.email }}</small></td>
                                <td>{{ item.contract }}<template v-if="item.cancelType === 'extraordinary'"><br><small><strong>{{ $t('shopproof.cancel.extraordinary') }}</strong>: {{ item.reason }}</small></template></td>
                                <td>{{ item.endMode === 'date' ? item.endDate : $t('shopproof.cancel.earliest') }}</td>
                                <td>
                                    <template v-if="item.doneAt">{{ $t('shopproof.cancel.doneOn', { date: formatTime(item.doneAt) }) }}</template>
                                    <template v-else>
                                        {{ $t('shopproof.cancel.openState') }}
                                        <small v-if="item.receiptSent !== '1'" role="note"><br>{{ $t('shopproof.cancel.noReceipt') }}</small>
                                        <br><mt-button size="small" variant="primary" @click="markCancellationDone(item.id)">{{ $t('shopproof.cancel.markDone') }}</mt-button>
                                    </template>
                                </td>
                                <td>
                                    <template v-if="confirmCancelId === item.id">
                                        <mt-button size="small" variant="critical" @click="removeCancellation(item.id)">{{ $t('shopproof.withdrawal.confirmDelete') }}</mt-button>
                                        <mt-button size="small" variant="secondary" @click="confirmCancelId = null">{{ $t('shopproof.withdrawal.cancel') }}</mt-button>
                                    </template>
                                    <mt-button v-else size="small" variant="secondary" @click="confirmCancelId = item.id">{{ $t('shopproof.withdrawal.delete') }}</mt-button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <sw-pagination
                        v-if="cancellations.total > 25"
                        :page="cancellationsPage"
                        :limit="25"
                        :total="cancellations.total"
                        :steps="[25]"
                        @page-change="onCancellationsPageChange"
                    />
                </template>
                <p><small>{{ $t('shopproof.cancel.next') }}</small></p>
            </mt-card>

            <mt-card
                position-identifier="shopproof-overview-returns"
                :title="$t('shopproof.returns.title')"
                :is-loading="returnsLoading"
            >
                <p>{{ $t('shopproof.returns.intro') }}</p>
                <template v-if="returns">
                    <p v-if="returns.webhookRejected" role="alert">{{ $t('shopproof.withdrawal.check.returnsUrl') }}</p>
                    <p v-else>{{ returns.webhookOn ? $t('shopproof.returns.on') : $t('shopproof.returns.off') }}</p>
                    <label for="shopproof-returns-secret">{{ $t('shopproof.returns.secret') }}</label>
                    <div class="shopproof-overview__search">
                        <input id="shopproof-returns-secret" :value="returns.secret" type="text" readonly class="shopproof-overview__search-input" aria-describedby="shopproof-returns-secret-help" @focus="$event.target.select()">
                        <mt-button variant="secondary" @click="renewSecret">{{ $t('shopproof.returns.renew') }}</mt-button>
                    </div>
                    <p id="shopproof-returns-secret-help"><small>{{ $t('shopproof.returns.secretHelp') }}</small></p>
                    <mt-button variant="secondary" :disabled="!returns.webhookOn || returnsTesting" @click="sendTest">{{ $t('shopproof.returns.test') }}</mt-button>
                    <p v-if="returnsResult" role="status">{{ returnsResult }}</p>
                </template>
            </mt-card>

            <mt-card
                v-for="(group, index) in groups"
                :id="index === 0 ? 'shopproof-rules' : undefined"
                :key="group.code"
                :position-identifier="`shopproof-overview-${group.code}`"
                :title="$t('shopproof.overview.groupTitle', { country: countryName(group.code), count: group.rules.length })"
            >
                <ul class="shopproof-overview__rules" :aria-label="countryName(group.code)">
                    <li v-for="rule in group.rules" :key="rule.id" class="shopproof-overview__rule">
                        <h3 class="shopproof-overview__rule-title">{{ rule.requirement }}</h3>
                        <p>{{ rule.shop_must }}</p>
                        <dl class="shopproof-overview__facts">
                            <div v-if="rule.effective_from">
                                <dt>{{ $t('shopproof.overview.effectiveFrom') }}</dt>
                                <dd>{{ rule.effective_from }}</dd>
                            </div>
                            <div v-if="rule.where_in_shop">
                                <dt>{{ $t('shopproof.overview.whereInShop') }}</dt>
                                <dd>{{ rule.where_in_shop }}</dd>
                            </div>
                            <div v-if="rule.legal_basis">
                                <dt>{{ $t('shopproof.overview.legalBasis') }}</dt>
                                <dd>
                                    <a :href="rule.source_url" target="_blank" rel="noopener noreferrer">
                                        {{ rule.legal_basis }}
                                        <span class="shopproof-overview__sr">{{ $t('shopproof.overview.opensNewTab') }}</span>
                                    </a>
                                </dd>
                            </div>
                        </dl>
                    </li>
                </ul>
            </mt-card>
            <shopproof-contact />
        </sw-card-view>
    </template>
</sw-page>
{% endblock %}
