{% block shopproof_overview_index %}
<sw-page class="shopproof-overview">
    <template #smart-bar-header>
        <h2>
            <span>{{ $t('sw-settings.index.title') }}</span>
            <mt-icon name="regular-chevron-right-xs" size="12px" />
            <span>{{ $t('shopproof.general.title') }}</span>
        </h2>
    </template>

    <template #content>
        <sw-card-view>
            <div v-if="check && check.failedRecords > 0" class="shopproof-overview__alert" role="alert">
                <p>
                    <strong>{{ $tc('shopproof.withdrawal.failedRecords', check.failedRecords, { count: check.failedRecords }) }}</strong>
                </p>
                <p>{{ $t('shopproof.withdrawal.failedHelp') }}</p>
                <mt-button size="small" variant="secondary" :disabled="clearing" @click="clearFailures">
                    {{ $t('shopproof.withdrawal.failedClear') }}
                </mt-button>
            </div>

            <mt-card
                position-identifier="shopproof-overview-about"
                :title="$t('shopproof.overview.aboutTitle')"
                :is-loading="isLoading"
            >
                <p class="shopproof-overview__disclaimer">
                    <strong>{{ overview && overview.disclaimer ? overview.disclaimer : $t('shopproof.overview.disclaimer') }}</strong>
                </p>
                <p v-if="failed" role="alert">{{ $t('shopproof.overview.loadFailed') }}</p>
                <p v-else-if="overview && !overview.available">{{ $t('shopproof.overview.notYet') }}</p>
                <p v-else-if="overview && overview.downloaded">
                    {{ $t('shopproof.overview.version', { version: overview.version, date: fetchedAt }) }}
                </p>
                <p v-else-if="overview">
                    {{ $t('shopproof.overview.versionBundled', { version: overview.version }) }}
                </p>
                <p>{{ $t('shopproof.overview.countriesHint') }}</p>
                <p v-if="overview">{{ overview.autoUpdate ? $t('shopproof.overview.autoOn') : $t('shopproof.overview.autoOff') }}</p>
                <mt-button variant="secondary" :is-loading="refreshing" :disabled="refreshing" @click="refreshRules">
                    {{ $t('shopproof.overview.refresh') }}
                </mt-button>
                <p v-if="refreshResult" role="status">{{ $t(`shopproof.overview.refresh_${refreshResult}`) }}</p>
            </mt-card>

            <mt-card
                position-identifier="shopproof-overview-withdrawal-check"
                :title="$t('shopproof.withdrawal.checkTitle')"
                :is-loading="!check && !checkFailed"
            >
                <p v-if="checkFailed" role="alert">{{ $t('shopproof.withdrawal.checkFailed') }}</p>
                <p v-else-if="check && !check.supported">{{ $t('shopproof.withdrawal.unsupported') }}</p>
                <template v-else-if="check">
                    <p :class="check.ok ? 'shopproof-overview__ok' : 'shopproof-overview__todo'">
                        <strong>{{ check.ok ? $t('shopproof.withdrawal.allGood') : $t('shopproof.withdrawal.needsWork') }}</strong>
                    </p>
                    <ul class="shopproof-overview__checks">
                        <li v-for="item in check.shop" :key="item.key">
                            <span class="shopproof-overview__state">{{ item.ok ? $t('shopproof.withdrawal.done') : $t('shopproof.withdrawal.todo') }}</span>
                            {{ checkText(item) }}
                        </li>
                    </ul>
                    <section v-for="channel in check.channels" :key="channel.id" :aria-label="channel.name">
                        <h3 class="shopproof-overview__rule-title">{{ channel.name }}</h3>
                        <ul class="shopproof-overview__checks">
                            <li v-for="item in channel.checks" :key="item.key">
                                <span class="shopproof-overview__state">{{ item.ok ? $t('shopproof.withdrawal.done') : $t('shopproof.withdrawal.todo') }}</span>
                                {{ checkText(item) }}
                            </li>
                        </ul>
                    </section>
                    <p>{{ $t('shopproof.withdrawal.where') }}</p>
                </template>
            </mt-card>

            <mt-card
                v-if="check && ((check.layouts && check.layouts.length) || (check.products && check.products.length))"
                position-identifier="shopproof-overview-layouts"
                :title="$t('shopproof.layouts.title')"
            >
                <ul v-if="check.products && check.products.length" class="shopproof-overview__checks">
                    <li v-for="item in check.products" :key="item.key">
                        <span class="shopproof-overview__state">{{ item.ok ? $t('shopproof.withdrawal.done') : $t('shopproof.products.warn') }}</span>
                        {{ $t(`shopproof.products.${item.key}_${item.ok ? 'ok' : 'off'}`) }}
                        <ul v-if="item.key === 'manufacturerDetails' && !item.ok" class="shopproof-overview__names">
                            <li v-for="manufacturer in check.manufacturersWithoutDetails" :key="manufacturer.id">
                                <router-link :to="{ name: 'sw.manufacturer.detail', params: { id: manufacturer.id } }">{{ manufacturer.name || manufacturer.id }}</router-link>
                            </li>
                        </ul>
                        <ul v-if="item.key === 'hazardStatements' && check.hazardProblems" class="shopproof-overview__names">
                            <li v-for="product in check.hazardProblems" :key="product.id">
                                <router-link :to="{ name: 'sw.product.detail', params: { id: product.id } }">{{ product.name || product.id }}</router-link>:
                                {{ product.codes.map((line) => `${line.code} (${$t(line.reason === 'own' ? 'shopproof.products.hazardOwn' : 'shopproof.products.hazardUnknown')})`).join(', ') }}
                            </li>
                        </ul>
                        <ul v-if="item.key === 'registrationNumbers' && check.registrationBadLines" class="shopproof-overview__names">
                            <li v-for="line in check.registrationBadLines" :key="line">{{ line }}</li>
                        </ul>
                    </li>
                </ul>
                <p v-if="check.layouts && check.layouts.length">{{ $t('shopproof.layouts.intro') }}</p>
                <ul v-if="check.layouts && check.layouts.length" class="shopproof-overview__checks">
                    <li v-for="layout in check.layouts" :key="layout.id">
                        <span class="shopproof-overview__state">{{ layout.ok ? $t('shopproof.withdrawal.done') : $t('shopproof.withdrawal.todo') }}</span>
                        <router-link :to="{ name: 'sw.cms.detail', params: { id: layout.id } }">{{ layout.name }}</router-link>:
                        {{ layout.ok ? $t('shopproof.layouts.ok') : $t('shopproof.layouts.missing', { blocks: layout.missing.map((part) => $t(`shopproof.layouts.part.${part}`)).join(', ') }) }}
                    </li>
                </ul>
            </mt-card>

            <mt-card
                position-identifier="shopproof-overview-proof-log"
                :title="$t('shopproof.proof.title')"
                :is-loading="proofLoading"
            >
                <p>{{ $t('shopproof.proof.intro') }}</p>
                <p v-if="proofFailed" role="alert">{{ $t('shopproof.proof.loadFailed') }}</p>
                <p v-else-if="proof && !proof.available" role="alert">{{ $t('shopproof.proof.unavailable') }}</p>
                <template v-else-if="proof">
                    <p v-if="proof.lastSnapshot">{{ $t('shopproof.proof.lastSnapshot', { date: proof.lastSnapshot }) }}</p>
                    <p>{{ proof.retentionDays > 0 ? $t('shopproof.proof.retention', { days: proof.retentionDays }) : $t('shopproof.proof.retentionAll') }}</p>
                    <div class="shopproof-overview__actions">
                        <mt-button variant="secondary" :is-loading="verifying" :disabled="verifying" @click="verifyProof">{{ $t('shopproof.proof.verify') }}</mt-button>
                        <mt-button variant="secondary" :is-loading="snapshotting" :disabled="snapshotting" @click="recordSnapshot">{{ $t('shopproof.proof.snapshot') }}</mt-button>
                        <mt-button variant="secondary" :disabled="proof.total === 0" @click="downloadProof">{{ $t('shopproof.proof.download') }}</mt-button>
                    </div>
                    <p v-if="verifyResult" role="status" :class="verifyResult.ok ? 'shopproof-overview__ok' : 'shopproof-overview__todo'">
                        {{ verifyResult.failed ? $t('shopproof.proof.verifyFailed') : (verifyResult.ok ? $t('shopproof.proof.verifyOk', { count: verifyResult.checked }) : $t('shopproof.proof.verifyBroken', { id: verifyResult.brokenAt, count: verifyResult.checked })) }}
                    </p>
                    <p v-if="proof.total === 0">{{ $t('shopproof.proof.none') }}</p>
                    <template v-else>
                        <table class="shopproof-overview__table">
                            <caption class="shopproof-overview__sr">{{ $t('shopproof.proof.title') }}</caption>
                            <thead>
                                <tr>
                                    <th scope="col">{{ $t('shopproof.proof.time') }}</th>
                                    <th scope="col">{{ $t('shopproof.proof.type') }}</th>
                                    <th scope="col">{{ $t('shopproof.proof.summary') }}</th>
                                    <th scope="col">{{ $t('shopproof.proof.hash') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="entry in proof.items" :key="entry.id">
                                    <td>{{ entry.created_at }}</td>
                                    <td>{{ $t(`shopproof.proof.types.${entry.type}`) }}</td>
                                    <td class="shopproof-overview__comment"><code>{{ entry.summary }}</code></td>
                                    <td><code :title="entry.hash">{{ entry.hash.slice(0, 12) }}</code></td>
                                </tr>
                            </tbody>
                        </table>
                        <sw-pagination
                            v-if="proof.total > 25"
                            :page="proofPage"
                            :limit="25"
                            :total="proof.total"
                            :steps="[25]"
                            @page-change="onProofPageChange"
                        />
                    </template>
                </template>
            </mt-card>

            <mt-card
                position-identifier="shopproof-overview-withdrawals"
                :title="$t('shopproof.withdrawal.listTitle')"
                :is-loading="withdrawalsLoading"
            >
                <p>{{ $t('shopproof.withdrawal.listIntro') }}</p>
                <form class="shopproof-overview__search" role="search" @submit.prevent="search">
                    <label for="shopproof-withdrawal-search">{{ $t('shopproof.withdrawal.searchLabel') }}</label>
                    <input id="shopproof-withdrawal-search" v-model="term" type="search" class="shopproof-overview__search-input">
                    <mt-button variant="secondary" type="submit">{{ $t('shopproof.withdrawal.search') }}</mt-button>
                </form>
                <p v-if="withdrawalsFailed" role="alert">{{ $t('shopproof.withdrawal.listFailed') }}</p>
                <p v-else-if="withdrawals && withdrawals.total === 0">{{ $t('shopproof.withdrawal.none') }}</p>
                <template v-else-if="withdrawals">
                    <table class="shopproof-overview__table">
                        <caption class="shopproof-overview__sr">{{ $t('shopproof.withdrawal.listTitle') }}</caption>
                        <thead>
                            <tr>
                                <th scope="col">{{ $t('shopproof.withdrawal.received') }}</th>
                                <th scope="col">{{ $t('shopproof.withdrawal.customer') }}</th>
                                <th scope="col">{{ $t('shopproof.withdrawal.contract') }}</th>
                                <th scope="col">{{ $t('shopproof.withdrawal.comment') }}</th>
                                <th scope="col"><span class="shopproof-overview__sr">{{ $t('shopproof.withdrawal.actions') }}</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="item in withdrawals.items" :key="item.id">
                                <td>{{ formatTime(item.submittedAt) }}<br><small>{{ item.salesChannel }}</small></td>
                                <td>{{ [item.firstName, item.lastName].filter(Boolean).join(' ') }}<br><a :href="`mailto:${item.email}`">{{ item.email }}</a></td>
                                <td>
                                    <router-link v-if="item.orderId" :to="orderLink(item.orderId)">{{ item.contractNumber }}</router-link>
                                    <template v-else>{{ item.contractNumber }}<br><small>{{ $t('shopproof.withdrawal.noOrder') }}</small></template>
                                </td>
                                <td class="shopproof-overview__comment">{{ item.comment }}</td>
                                <td>
                                    <template v-if="confirmId === item.id">
                                        <mt-button size="small" variant="critical" @click="removeWithdrawal(item.id)">{{ $t('shopproof.withdrawal.confirmDelete') }}</mt-button>
                                        <mt-button size="small" variant="secondary" @click="confirmId = null">{{ $t('shopproof.withdrawal.cancel') }}</mt-button>
                                    </template>
                                    <mt-button v-else size="small" variant="secondary" @click="confirmId = item.id">{{ $t('shopproof.withdrawal.delete') }}</mt-button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <sw-pagination
                        v-if="withdrawals.total > 25"
                        :page="page"
                        :limit="25"
                        :total="withdrawals.total"
                        :steps="[25]"
                        @page-change="onPageChange"
                    />
                </template>
            </mt-card>

            <mt-card
                v-for="group in groups"
                :key="group.code"
                :position-identifier="`shopproof-overview-${group.code}`"
                :title="$t('shopproof.overview.groupTitle', { country: countryName(group.code), count: group.rules.length })"
            >
                <ul class="shopproof-overview__rules" :aria-label="countryName(group.code)">
                    <li v-for="rule in group.rules" :key="rule.id" class="shopproof-overview__rule">
                        <h3 class="shopproof-overview__rule-title">{{ rule.requirement }}</h3>
                        <p>{{ rule.shop_must }}</p>
                        <dl class="shopproof-overview__facts">
                            <div v-if="rule.effective_from">
                                <dt>{{ $t('shopproof.overview.effectiveFrom') }}</dt>
                                <dd>{{ rule.effective_from }}</dd>
                            </div>
                            <div v-if="rule.where_in_shop">
                                <dt>{{ $t('shopproof.overview.whereInShop') }}</dt>
                                <dd>{{ rule.where_in_shop }}</dd>
                            </div>
                            <div v-if="rule.legal_basis">
                                <dt>{{ $t('shopproof.overview.legalBasis') }}</dt>
                                <dd>
                                    <a :href="rule.source_url" target="_blank" rel="noopener noreferrer">
                                        {{ rule.legal_basis }}
                                        <span class="shopproof-overview__sr">{{ $t('shopproof.overview.opensNewTab') }}</span>
                                    </a>
                                </dd>
                            </div>
                        </dl>
                    </li>
                </ul>
            </mt-card>
        </sw-card-view>
    </template>
</sw-page>
{% endblock %}
